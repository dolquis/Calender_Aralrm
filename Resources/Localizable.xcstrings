        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘルスケアアクセス有効"
          }
        }
      }
    },
    "sleep.healthkit_footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When authorized, shift-based sleep windows are saved to the Health app for sleep tracking."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可すると、シフトに基づく睡眠ウィンドウがヘルスケアアプリに保存されます。"
          }
        }
      }
    },
    "sleep.healthkit_unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Health Not Available"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘルスケア非対応"
          }
        }
      }
    },
    "sleep.limitation_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS does not allow third-party apps to directly modify the Health app’s Sleep Schedule or Clock app alarms. This guide shows you how to automate it using Shortcuts personal automations with our App Intents."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOSのサンドボックス制約により、サードパーティアプリがヘルスケアの睡眠スケジュールや時計アプリのアラームを直接書き換えることはできません。本ガイドでは、ショートカットの個人用オートメーションとApp Intentsを使って自動化する方法を説明します。"
          }
        }
      }
    },
    "sleep.limitation_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS API Limitations"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS APIの制約"
          }
        }
      }
    },
    "sleep.nav_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep Schedule"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "睡眠スケジュール"
          }
        }
      }
    },
    "sleep.no_windows_description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set up shift presets with alarm times to see bedtime and wake schedules here."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アラーム時刻を設定したシフトプリセットを追加すると、就寝・起床スケジュールが表示されます。"
          }
        }
      }
    },
    "sleep.no_windows_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Upcoming Alarms"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今後のアラームなし"
          }
        }
      }
    },
    "sleep.section_healthkit": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Health Integration"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘルスケア連携"
          }
        }
      }
    },
    "sleep.section_limitation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Why Can’t It Be Fully Automatic?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完全自動にできない理由"
          }
        }
      }
    },
    "sleep.section_shortcuts": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shortcuts Automation"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカット自動化"
          }
        }
      }
    },
    "sleep.section_upcoming": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upcoming Sleep Windows"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今後の睡眠ウィンドウ"
          }
        }
      }
    },
    "sleep.shortcuts_footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a personal automation in Shortcuts to automatically update your iOS Sleep Focus and Clock alarms based on your shift calendar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットの個人用オートメーションを使って、シフトカレンダーに基づいてiOSの睡眠フォーカスと時計アプリのアラームを自動更新できます。"
          }
        }
      }
    },
    "sleep.shortcuts_guide_button": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shortcuts Setup Guide"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカット設定ガイド"
          }
        }
      }
    },
    "sleep.shortcuts_guide_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shortcuts Setup"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカット設定"
          }
        }
      }
    },
    "sleep.shortcuts_setup": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set Up Shortcuts Automation"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカット自動化を設定"
          }
        }
      }
    },
    "sleep.step1_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the Shortcuts app and tap Automation → New Automation → Time of Day. Set it to run daily (e.g. 6 PM). Then add the following actions:"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットアプリを開き、「オートメーション」→「新規オートメーション」→「時刻」をタップ。毎日（例：18:00）実行するよう設定し、以下のアクションを追加します："
          }
        }
      }
    },
    "sleep.step1_intents": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1. Get Next Sleep Window (ShiftAlarm)\n2. Toggle Sleep Focus\n3. Set Alarm (using bedtime from step 1)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1. 次の睡眠ウィンドウを取得（シフトアラーム）\n2. 睡眠フォーカスをオン\n3. アラームを設定（ステップ1の就寝時刻を使用）"
          }
        }
      }
    },
    "sleep.step1_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Step 1 — Open Shortcuts"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ステップ1 — ショートカットを開く"
          }
        }
      }
    },
    "sleep.step2_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After creating the automation, tap Done. Enable “Run Automatically” so it fires without requiring manual confirmation each time."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オートメーションを作成後、「完了」をタップ。「自動実行」を有効にして、毎回の確認なしに実行されるようにします。"
          }
        }
      }
    },
    "sleep.step2_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Step 2 — Enable Run Automatically"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ステップ2 — 自動実行を有効化"
          }
        }
      }
    },
    "sleep.step3_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each evening the automation fetches your next shift’s sleep window and updates your Sleep Focus schedule and Clock alarm automatically."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎晩オートメーションが次のシフトの睡眠ウィンドウを取得し、睡眠フォーカスと時計のアラームを自動更新します。"
          }
        }
      }
    },
    "sleep.step3_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Step 3 — That’s It!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ステップ3 — 完了！"
          }
        }
      }
    },
