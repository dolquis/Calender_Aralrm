# Xcode
build/
DerivedData/
*.xcuserstate
*.xcuserdatad/
xcuserdata/
*.swp
.DS_Store
Config/LocalSigning.xcconfig

# Swift Package Manager
.build/
Packages/
# Ignore stray resolved files (e.g. from SwiftPM CLI builds), but keep the one
# xcodebuild reads from the generated project. Committing it pins dependency
# versions and gives CI a stable SwiftPM cache key. XcodeGen `generate` does
# not overwrite this path, so it survives scripts/regen.sh.
Package.resolved
!ShiftAlarm.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved

# CocoaPods (not used, kept for safety)
Pods/

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

# XcodeGen — keep project.yml; .xcodeproj is regeneratable but committed
# (do NOT ignore *.xcodeproj here)

# SourceKit-LSP (machine-specific paths; regenerate via scripts/lsp-setup.sh)
buildServer.json

# lychee link-checker cache
.lycheecache

# Misc
*.log
.env
.env.*
